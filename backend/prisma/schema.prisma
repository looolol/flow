generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemState {
  id                Int       @id @default(autoincrement())
  key               String    @unique
  value             String
  updatedAt         DateTime  @updatedAt

  @@map("system")
}

enum GameState {
  OFF
  PRE
  LIVE
  CRIT
  FUT
}

model Game {
  id                String    @id
  season            String
  gameType          Int
  venue             String
  startTimeUTC      DateTime
  gameState         GameState
  awayTeamId        String
  awayTeamScore     Int?
  awayTeamSOG       Int?
  homeTeamId        String
  homeTeamScore     Int?
  homeTeamSOG       Int?
  period            Int?
  secondsRemaining  Int?
  clockRunning      Boolean   @default(false)
  inIntermission    Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  awayTeam          Team      @relation("AwayGames", fields: [awayTeamId], references: [id])
  homeTeam          Team      @relation("HomeGames", fields: [homeTeamId], references: [id])

  @@map("games")
}

model Team {
  id                String    @id
  name              String
  place             String
  abbrev            String
  logo              String

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  awayGames         Game[]    @relation("AwayGames")
  homeGames         Game[]    @relation("HomeGames")

  @@map("teams")
}